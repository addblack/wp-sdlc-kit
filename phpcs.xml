<?xml version="1.0"?>
<ruleset name="Project">
	<description>WordPress Coding Standards for this project. Search for TODO and adjust.</description>

	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<!-- PHP compatibility. TODO: match the "Requires PHP" header of your plugin/theme. -->
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- TODO: minimum supported WordPress version. -->
	<config name="minimum_wp_version" value="6.4"/>

	<rule ref="WordPress">
		<!-- Allow PSR-4 style class files (src/Foo/Bar.php). Remove if you use WP-style class-foo.php names. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>

	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- TODO: your text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="your-text-domain"/>
			</property>
		</properties>
	</rule>

	<!-- TODO: your global prefix (functions, hooks, options, globals). -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="yourprefix"/>
			</property>
		</properties>
	</rule>
</ruleset>
